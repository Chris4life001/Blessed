    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "ethers": "^6.16.0",
    "express": "^5",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "openai": "^6.35.0",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/hpp": "^0.2.7",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
