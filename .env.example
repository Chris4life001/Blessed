# =============================================================================
# XpressPro FX — Environment Variables
# Copy this file to .env and fill in all values before starting the server.
# NEVER commit .env to version control — it is in .gitignore.
# =============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Port the API server listens on (Railway injects this automatically)
PORT=8080

# Node environment: production | development
NODE_ENV=production

# Strong random secret for signing session cookies (min 64 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SESSION_SECRET=

# Strong random secret for signing JWT tokens (min 64 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=

# ── DATABASE ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Neon:      postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Supabase:  postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Railway:   ${{Postgres.DATABASE_URL}}   (auto-injected)
# Local:     postgresql://postgres:postgres@localhost:5432/xpressprofx
DATABASE_URL=

# ── ADMIN ACCOUNT ────────────────────────────────────────────────────────────

# Admin portal credentials — provisioned at startup if both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: email address that receives admin alert mirrors
ADMIN_NOTIFY_EMAIL=

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origin URLs (required in production).
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# ── EMAIL DELIVERY ────────────────────────────────────────────────────────────

# SendGrid (preferred). When set, all transactional emails go via SendGrid.
# Get a key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# SMTP fallback (used only when SendGrid is not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── BLOCKCHAIN / CRYPTO ───────────────────────────────────────────────────────

# Alchemy API key for live blockchain data (optional — falls back to public provider)
# Get at: https://www.alchemy.com/
ALCHEMY_API_KEY=

# Infura API key (alternative to Alchemy)
INFURA_API_KEY=

# Platform receiving address for deposits (Ethereum / EVM-compatible)
PLATFORM_RECEIVING_ADDRESS=

# ── PAYMENT PROVIDERS ─────────────────────────────────────────────────────────

# MoonPay (buy crypto with card). Both keys are REQUIRED if API key is set in production.
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_SECRET=

# Coinbase Commerce / On-ramp
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_WEBHOOK_SECRET=

# ── AI / OPENAI ───────────────────────────────────────────────────────────────

# OpenAI API key for AI assistant / live chat (optional — degrades gracefully)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── APPLICATION ───────────────────────────────────────────────────────────────

# Platform display name used in emails and UI
APP_NAME=XpressPro FX

# ── REPLIT (auto-injected on Replit — do not set manually) ───────────────────
# REPLIT_DOMAINS=
# REPL_ID=
